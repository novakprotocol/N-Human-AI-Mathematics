[2026-07-29T18:58:07.4356888-04:00] START 12-serve-fetch :: Serve/fetch corrected public pages
[2026-07-29T18:58:07.4366896-04:00] COMMAND $listener = [System.Net.Sockets.TcpListener]::new([System.Net.IPAddress]::Loopback, 0); $listener.Start(); $port = $listener.LocalEndpoint.Port; $listener.Stop();
$docs = (Resolve-Path -LiteralPath 'docs').Path;
$proc = Start-Process -FilePath python -ArgumentList @('-m','http.server',$port,'--bind','127.0.0.1','--directory',$docs) -PassThru -WindowStyle Hidden -RedirectStandardOutput '<PUBLIC_WORKSPACE_ROOT>\nhaim-public-status-v4-output-dda1d03-run2\serve-http.stdout.log' -RedirectStandardError '<PUBLIC_WORKSPACE_ROOT>\nhaim-public-status-v4-output-dda1d03-run2\serve-http.stderr.log';
try {
  Start-Sleep -Seconds 2;
  $index = (Invoke-WebRequest -UseBasicParsing -Uri "http://127.0.0.1:$port/index.html").Content;
  $learn = (Invoke-WebRequest -UseBasicParsing -Uri "http://127.0.0.1:$port/learn.html").Content;
  $checks = @(
    ($index -match 'HINC-001</dt><dd>Active candidate public technical review'),
    ($index -match 'ABF-001</dt><dd>Active candidate public technical review'),
    ($index -match 'FSG-001</dt><dd>Private; HOLD'),
    ($index -match 'ACM-001</dt><dd>Hold pending consolidation'),
    ($learn -match 'FSG-001 teaching preview paused'),
    ($learn -match 'HINC-001 and ABF-001 are unaffected')
  );
  $ok = -not ($checks -contains $false);
  $result = if ($ok) { 'PASS' } else { 'FAIL' }; [ordered]@{ schema='nhaim.public_status.serve_fetch.v4'; result=$result; port=$port; checks=$checks } | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath '<PUBLIC_WORKSPACE_ROOT>\nhaim-public-status-v4-output-dda1d03-run2\serve-fetch-receipt.json' -Encoding utf8;
  if (-not $ok) { exit 1 }
}
finally {
  if ($proc -and -not $proc.HasExited) { Stop-Process -Id $proc.Id -Force }
}
