{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/novakprotocol/N-Human-AI-Mathematics/schemas/research-index.schema.json",
  "title": "N Human-LLM Mathematics Research Index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "repository_visibility_required",
    "accountable_owner",
    "operating_mode",
    "public_release_authorized",
    "public_switch_ready",
    "release_channel",
    "release_version",
    "specific_model_disclosed",
    "specific_provider_disclosed",
    "papers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "n.human_ai_mathematics.research_index.v1"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_visibility_required": {
      "enum": [
        "private",
        "public"
      ]
    },
    "accountable_owner": {
      "type": "string",
      "minLength": 1
    },
    "operating_mode": {
      "const": "human-led-ai-assisted"
    },
    "public_release_authorized": {
      "type": "boolean"
    },
    "public_switch_ready": {
      "type": "boolean"
    },
    "release_channel": {
      "enum": [
        "public_review",
        "archival_release",
        "journal_submission"
      ]
    },
    "release_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "specific_model_disclosed": {
      "type": "boolean"
    },
    "specific_provider_disclosed": {
      "type": "boolean"
    },
    "papers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "active_review",
        "hold",
        "archived_case_study",
        "rejected",
        "superseded",
        "published"
      ]
    },
    "formalObject": {
      "type": "object",
      "additionalProperties": true
    },
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "title",
        "fields",
        "state",
        "claim_status",
        "human_proof",
        "internal_reproduction",
        "formal_verification",
        "external_specialist_review",
        "historical_priority",
        "peer_review",
        "public_release"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]{2,8}-[0-9]{3}$"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 8
        },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "claim_status": {
          "type": "string",
          "minLength": 1
        },
        "human_proof": {
          "type": "string",
          "minLength": 1
        },
        "internal_reproduction": {
          "type": "string",
          "minLength": 1
        },
        "formal_verification": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "$ref": "#/$defs/formalObject"
            }
          ]
        },
        "external_specialist_review": {
          "type": "string",
          "minLength": 1
        },
        "historical_priority": {
          "type": "string",
          "minLength": 1
        },
        "peer_review": {
          "type": "string",
          "minLength": 1
        },
        "public_release": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
