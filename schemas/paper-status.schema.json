{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/novakprotocol/N-Human-AI-Mathematics/schemas/paper-status.schema.json",
  "title": "N Human-AI Mathematics Paper Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "paper_id",
    "title",
    "source",
    "claim",
    "proof",
    "computation",
    "formal_verification",
    "review",
    "release",
    "limitations"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "n.human_ai_mathematics.paper_status.v1"},
    "paper_id": {"type": "string", "pattern": "^[A-Z]{2,8}-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 8},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "paths"],
      "properties": {
        "repository": {"type": "string"},
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status", "globally_novel", "security_consequence"],
      "properties": {
        "level": {"type": "integer", "minimum": 0, "maximum": 9},
        "status": {"type": "string"},
        "globally_novel": {"enum": ["established", "unestablished", "not_claimed"]},
        "security_consequence": {"enum": ["established", "unestablished", "not_applicable", "not_claimed"]}
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_proof_status", "dependency_map", "known_gaps"],
      "properties": {
        "human_proof_status": {"type": "string"},
        "dependency_map": {"type": "string"},
        "known_gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "computation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "primary_status", "independent_status", "receipts"],
      "properties": {
        "role": {"type": "string"},
        "primary_status": {"type": "string"},
        "independent_status": {"type": "string"},
        "receipts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "formal_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "assistant", "verified_scope", "unverified_scope", "receipts"],
      "properties": {
        "status": {"type": "string"},
        "assistant": {"type": ["string", "null"]},
        "verified_scope": {"type": "array", "items": {"type": "string"}},
        "unverified_scope": {"type": "array", "items": {"type": "string"}},
        "receipts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["internal", "external", "historical_priority", "peer_review"],
      "properties": {
        "internal": {"type": "string"},
        "external": {"type": "string"},
        "historical_priority": {"type": "string"},
        "peer_review": {"type": "string"}
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_authorized", "version", "doi"],
      "properties": {
        "public_authorized": {"type": "boolean"},
        "version": {"type": ["string", "null"]},
        "doi": {"type": ["string", "null"]}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
